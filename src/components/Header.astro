---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/#work', label: 'Work' },
  { href: '/#about', label: 'About' },
];
---

<header class="border-b border-slate-200 dark:border-slate-800">
	<div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-4">
		<a href="/" class="font-semibold tracking-tight">
			<span class="sm:hidden">Philip Afriyie</span>
			<span class="hidden sm:inline">Philip Baah Afriyie</span>
		</a>
		<nav aria-label="Primary">
			<ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
				{navItems.map((item) => (
					<li>
						<a href={item.href} class="text-slate-600 hover:text-accent dark:text-slate-300 dark:hover:text-accent-light">
							{item.label}
						</a>
					</li>
				))}
				<li>
					<a
						href="/Philip_Baah_Afriyie_Resume.pdf"
						class="rounded border border-slate-300 px-3 py-1.5 text-slate-900 hover:border-accent hover:text-accent dark:border-slate-700 dark:text-slate-100 dark:hover:border-accent-light dark:hover:text-accent-light"
					>
						Resume
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>
