---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PipelineThumbnail from '../components/PipelineThumbnail.astro';
import headshot from '../assets/philip-headshot.jpg';

const caseStudies = (await getCollection('caseStudies'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// Simplified previews of each case study's full architecture diagram — no fine print, since a
// full diagram's small text labels would be illegible shrunk to card size (see PipelineThumbnail).
const thumbnails: Record<string, { steps: [string, string, string, string]; highlight: number; label: string }> = {
  'voice-ai-survey-platform': { steps: ['ASR', 'MT', 'Route', 'TTS'], highlight: 2, label: 'Speech recognition, translation, routing, speech synthesis' },
  'akan-english-speech-pipeline': { steps: ['STT', 'MT', 'TTS', 'Triton'], highlight: 3, label: 'Speech-to-text, translation, text-to-speech, served on Triton' },
  'docu-ai': { steps: ['Parse', 'Plan', 'Emit', 'Verify'], highlight: 3, label: 'Parse, plan, emit, verify pipeline' },
};

const shortEntries = [
  {
    title: 'Agentic document extraction',
    summary:
      'An end-to-end pipeline that ingests raw PDFs and scanned images and converts them into structured PostgreSQL records via OCR, with downstream agents running analytics on the extracted data to generate reports automatically. Prototype, not deployed to production.',
    stack: ['OCR (Tesseract, PaddleOCR)', 'PostgreSQL', 'Python'],
  },
  {
    title: 'Computer vision for agriculture',
    summary:
      'Object detection models for automated crop counting: 91.8% precision on banana trees with MMDetection and 94% precision on palm trees with Ultralytics YOLOv8, to improve harvest planning.',
    stack: ['MMDetection', 'Ultralytics YOLOv8', 'Object detection'],
  },
];

const skillGroups = [
  { label: 'Languages', items: ['Python', 'TypeScript', 'JavaScript', 'SQL', 'Bash'] },
  {
    label: 'AI and LLM systems',
    items: [
      'LangChain', 'LangGraph', 'Agentic RAG', 'Retrieval-augmented generation',
      'Prompt engineering', 'Claude on AWS Bedrock', 'Hugging Face Transformers', 'PyTorch',
      'Model fine-tuning', 'OCR (Tesseract, PaddleOCR)',
    ],
  },
  {
    label: 'Machine learning',
    items: ['Scikit-learn', 'MMDetection', 'Ultralytics YOLOv8', 'Object detection', 'NLP', 'Speech AI'],
  },
  {
    label: 'MLOps and infrastructure',
    items: [
      'Docker', 'Kubernetes', 'NVIDIA Triton', 'Terraform', 'Ansible', 'Kafka', 'Redis',
      'Gunicorn', 'nginx', 'MLflow', 'DVC',
    ],
  },
  {
    label: 'Cloud and data',
    items: ['AWS (EC2, S3, Lambda, Bedrock)', 'PostgreSQL', 'FastAPI', 'REST APIs', 'OAuth 2.0'],
  },
];
---

<Layout
	title="Philip Baah Afriyie — AI/ML Engineer"
	description="AI/ML Engineer specializing in speech and vision for low-resource African languages, and applied MLOps."
>
	<section class="mx-auto flex max-w-3xl flex-col gap-6 px-6 pb-16 pt-20 sm:flex-row sm:items-start">
		<Image
			src={headshot}
			alt="Philip Baah Afriyie"
			width={224}
			loading="eager"
			fetchpriority="high"
			class="h-28 w-28 shrink-0 rounded-full object-cover object-top ring-1 ring-slate-800"
		/>
		<div>
			<p class="mb-3 text-sm font-medium uppercase tracking-wide text-accent">
				AI/ML Engineer · Speech, Vision &amp; Applied MLOps
			</p>
			<h1 class="mb-6 text-3xl font-semibold tracking-tight sm:text-4xl">Philip Baah Afriyie</h1>
			<p class="max-w-2xl text-lg leading-relaxed text-slate-300">
				Three years at Ayadata fine-tuning ASR, MT and TTS on code-switched Twi and Akan speech,
				building computer vision for crop detection, and shipping the agentic AI — LangChain and
				LangGraph agents, retrieval-augmented generation — that puts those models to work. Accra,
				Ghana — open to remote.
			</p>
		</div>
	</section>

	<section id="work" class="mx-auto max-w-3xl px-6 pb-20">
		<h2 class="mb-8 text-xl font-semibold tracking-tight">Selected work</h2>
		<ul class="flex flex-col gap-6">
			{caseStudies.map((entry) => (
				<li>
					<a
						href={`/work/${entry.id}/`}
						class="block overflow-hidden rounded-lg border border-slate-800 transition hover:border-accent"
					>
						{thumbnails[entry.id] && (
							<div class="border-b border-slate-800 bg-slate-900/50 px-6 py-4">
								<PipelineThumbnail
									steps={thumbnails[entry.id].steps}
									highlight={thumbnails[entry.id].highlight}
									label={thumbnails[entry.id].label}
								/>
							</div>
						)}
						<div class="p-6">
							<h3 class="mb-2 font-semibold">{entry.data.title}</h3>
							<p class="mb-4 text-sm leading-relaxed text-slate-400">
								{entry.data.summary}
							</p>
							<p class="flex flex-wrap gap-2 text-xs text-slate-400">
								{entry.data.stack.map((tech) => <span>{tech}</span>)}
							</p>
						</div>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="mx-auto max-w-3xl px-6 pb-20">
		<h2 class="mb-8 text-xl font-semibold tracking-tight">Other work</h2>
		<ul class="flex flex-col gap-6">
			{shortEntries.map((item) => (
				<li class="rounded-lg border border-slate-800 p-6">
					<h3 class="mb-2 font-semibold">{item.title}</h3>
					<p class="mb-4 text-sm leading-relaxed text-slate-400">
						{item.summary}
					</p>
					<p class="flex flex-wrap gap-2 text-xs text-slate-400">
						{item.stack.map((tech) => <span>{tech}</span>)}
					</p>
				</li>
			))}
		</ul>
	</section>

	<section class="mx-auto max-w-3xl px-6 pb-24">
		<h2 class="mb-8 text-xl font-semibold tracking-tight">Skills</h2>
		<dl class="flex flex-col gap-5">
			{skillGroups.map((group) => (
				<div class="grid grid-cols-1 gap-1 sm:grid-cols-[11rem_1fr] sm:gap-4">
					<dt class="text-sm font-medium text-slate-100">{group.label}</dt>
					<dd class="text-sm leading-relaxed text-slate-400">
						{group.items.join(', ')}
					</dd>
				</div>
			))}
		</dl>
	</section>
</Layout>
