---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const caseStudies = (await getCollection('caseStudies'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
	title="Philip Baah Afriyie — AI/ML Engineer"
	description="AI/ML Engineer specializing in speech and vision for low-resource African languages, and applied MLOps."
>
	<section class="mx-auto max-w-3xl px-6 pb-16 pt-20">
		<p class="mb-3 text-sm font-medium uppercase tracking-wide text-accent dark:text-accent-light">
			AI/ML Engineer · Speech, Vision &amp; Applied MLOps
		</p>
		<h1 class="mb-6 text-3xl font-semibold tracking-tight sm:text-4xl">Philip Baah Afriyie</h1>
		<p class="max-w-2xl text-lg leading-relaxed text-slate-700 dark:text-slate-300">
			<!-- TODO(Phase 2): finalize this positioning paragraph against CLAUDE.md §4 voice rules
			     and the corrected resume before this ships. -->
			Three years fine-tuning ASR, MT and TTS on code-switched Twi and Akan speech, computer
			vision for crop detection, and the agentic AI that puts those models to work — accountable
			for a system from research notebook to production-ready handoff. Accra, Ghana — open to
			remote.
		</p>
	</section>

	<section id="work" class="mx-auto max-w-3xl px-6 pb-20">
		<h2 class="mb-8 text-xl font-semibold tracking-tight">Selected work</h2>
		<ul class="flex flex-col gap-6">
			{caseStudies.map((entry) => (
				<li>
					<a
						href={`/work/${entry.id}/`}
						class="block rounded-lg border border-slate-200 p-6 transition hover:border-accent dark:border-slate-800 dark:hover:border-accent-light"
					>
						<h3 class="mb-2 font-semibold">{entry.data.title}</h3>
						<p class="mb-4 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
							{entry.data.summary}
						</p>
						<p class="flex flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-500">
							{entry.data.stack.map((tech) => <span>{tech}</span>)}
						</p>
					</a>
				</li>
			))}
		</ul>
		<!-- TODO(Phase 2): add the two short entries (document extraction, computer vision for
		     agriculture) per CLAUDE.md §4 "Scope" — homepage-only, no dedicated page. -->
	</section>
</Layout>
